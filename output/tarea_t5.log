. putexcel A1 = "sector" B1 = "coef_educ" C1 = "se_educ" D1 = "n"
file output/tarea_t5_por_sector.xlsx saved

. 
. local fila_xls = 2

. local idx = 1

. foreach s of local sectores {
  2.     putexcel A`fila_xls' = "`s'"
  3.     putexcel B`fila_xls' = matrix(res_sector[`idx', 1]), nformat("#,##0.00")
  4.     putexcel C`fila_xls' = matrix(res_sector[`idx', 2]), nformat("#,##0.00")
  5.     putexcel D`fila_xls' = matrix(res_sector[`idx', 3]), nformat("#,##0")
  6.     local fila_xls = `fila_xls' + 1
  7.     local idx = `idx' + 1
  8. }
